# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection
# Replace with your actual Neon PostgreSQL connection string in your local .env file
# Format: postgres://username:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=YOUR_NEON_DATABASE_CONNECTION_STRING

# Frontend Application URL (for CORS validation)
CLIENT_URL=http://localhost:5173
