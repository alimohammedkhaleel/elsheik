{
  "name": "distribution-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "نظام إدارة ومتابعة عملاء التوزيع - مؤسسة الشيخ (Distribution Customer Management System)",
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "typecheck": "npm --prefix client run typecheck"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.2.12",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.396.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "keywords": [
    "distribution",
    "customer-management",
    "sheikh-foundation",
    "erp",
    "react",
    "express",
    "postgresql",
    "neon"
  ],
  "author": "Sheikh Foundation Engineering Team",
  "license": "UNLICENSED"
}
